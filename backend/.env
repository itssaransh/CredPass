DATABASE_URL=postgresql://credpass:credpass@localhost:5432/credpass
PORT=4000
# EVALUATOR_PRIVATE_KEY is intentionally omitted here:
# server.js falls back to the deterministic local dev key, which derives the
# evaluator address that MUST match the deployed evaluator in
# contracts/config/deploy-local.json (0x19E7E376E7C213B7E7e7e46cc70A5dD086DAff2A).
# Only set this variable if the value derives exactly that address.
# FAUCET_PRIVATE_KEY is also optional (local hardhat node only): if omitted the
# backend falls back to the publicly known Hardhat default account #0 key.
